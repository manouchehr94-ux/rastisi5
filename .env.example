# ============================================================================
# Environment configuration template for this Django project.
#
# Copy to `.env` (or export these as real process environment variables) and
# fill in real values for your deployment. This file must never contain real
# secrets — placeholders only. Do not commit a real `.env` file.
#
# Local development and the test suite need NONE of these set: every
# variable has a safe default that reproduces the previous hardcoded
# development behavior. See docs/deployment/PRODUCTION_CONFIGURATION.md for
# the full explanation of each variable and a staged production rollout.
# ============================================================================

# ---- Django core -----------------------------------------------------------

# Required when DJANGO_DEBUG=False. Generate a real value with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# Never reuse the repository's development key, never commit a real value.
DJANGO_SECRET_KEY=

# Must be False in production.
DJANGO_DEBUG=False

# Comma-separated hostnames this deployment is allowed to serve. Required
# when DJANGO_DEBUG=False. No wildcards.
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# Comma-separated, fully-qualified origins (scheme + host) trusted to submit
# cross-origin POSTs — needed once you're served over a real HTTPS domain.
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# ---- HTTPS / secure cookies -------------------------------------------------
# Enable only once the deployment is reachable over HTTPS end-to-end for
# every hostname above — turning these on before HTTPS works will lock
# customers out.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# HSTS: start at 0. Raise gradually (e.g. 3600 -> 86400 -> 31536000) only
# after confirming HTTPS works reliably — see the staged rollout in
# docs/deployment/PRODUCTION_CONFIGURATION.md. Browsers that accept HSTS
# will refuse plain HTTP for the configured duration; there is no "undo".
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Only set this if your reverse proxy is configured to strip/overwrite this
# header for ALL client traffic (never trust a client-supplied header
# directly — misconfiguring this lets a client spoof HTTPS detection).
# Format: "Header-Name:expected-value".
# DJANGO_SECURE_PROXY_SSL_HEADER=X-Forwarded-Proto:https

# ---- Database ---------------------------------------------------------------
# Leave unset for local development/tests — falls back to a local SQLite
# file. Set to a PostgreSQL URL for production:
#   DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<database-name>
DATABASE_URL=

# ---- Static & media files ----------------------------------------------------
# Absolute paths on the server. Media (product images, uploaded logos, etc.)
# must live on persistent, backed-up storage — see the deployment doc.
DJANGO_STATIC_ROOT=/var/www/akhlaghi/staticfiles
DJANGO_MEDIA_ROOT=/var/www/akhlaghi/media

# ---- Logging ------------------------------------------------------------------
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
DJANGO_LOG_LEVEL=INFO

# ---- Merchant admin subdomain suffix ----------------------------------------------
# f"{store.admin_subdomain}.{RASTISI_ADMIN_DOMAIN_SUFFIX}" is a Store's stable
# merchant admin host (see ADR-16 in docs/architecture/SAAS_DOMAIN_DECISIONS.md).
# Independent of any public storefront domain.
RASTISI_ADMIN_DOMAIN_SUFFIX=rastisi.ir

# ---- SMS gateway ----------------------------------------------------------------
# Melipayamak credentials are configured per-Store through the merchant
# dashboard (stored in the database), not here — nothing to set at the
# environment level for SMS today.

# ---- Payment simulation (placeholder flow, pre-Zibal) ----------------------------
# There is no real payment gateway yet. Leave unset — it defaults to False
# whenever DJANGO_DEBUG=False, which is what production must have. Never set
# this to True in a real deployment; it exists only for local dev/QA.
# PAYMENTS_SIMULATION_ENABLED=False

# ---- Payment credential encryption ------------------------------------------------
# Required in production (DEBUG=False). Encrypts gateway credentials (merchant
# IDs, API keys) stored in the database. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER reuse Django's SECRET_KEY — this key has an independent lifecycle.
# Rotating this key requires re-entering all gateway credentials.
PAYMENT_CREDENTIAL_KEY=
